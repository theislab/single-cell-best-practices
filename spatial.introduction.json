{"version":3,"kind":"Notebook","sha256":"aac3fa2ff5bd9de73c3008109e9130d22072d0babbc427affeba1d68899b4ae3","slug":"spatial.introduction","location":"/spatial/introduction.ipynb","dependencies":[],"frontmatter":{"title":"Single-cell data resolved in space","authors":[{"nameParsed":{"literal":"Anna Schaar","given":"Anna","family":"Schaar"},"name":"Anna Schaar","id":"contributors-introduction-generated-uid-0"},{"nameParsed":{"literal":"Lukas Heumos","given":"Lukas","family":"Heumos"},"name":"Lukas Heumos","roles":["Writing – review & editing"],"id":"contributors-introduction-generated-uid-1"}],"content_includes_title":false,"kernelspec":{"name":"cell2loc_env","display_name":"Environment (cell2loc_env)","language":"python"},"github":"https://github.com/theislab/single-cell-best-practices","settings":{"output_matplotlib_strings":"remove"},"numbering":{"title":{"offset":1}},"source_url":"https://github.com/theislab/single-cell-best-practices/blob/main/jupyter-book/spatial/introduction.ipynb","edit_url":"https://github.com/theislab/single-cell-best-practices/edit/main/jupyter-book/spatial/introduction.ipynb","thumbnail":"/build/introduction_1-9323e157da1e3ccd01cd8c12be2b23a8.jpeg","exports":[{"format":"ipynb","filename":"introduction.ipynb","url":"/build/introduction-6b1fc693d70f4f9cd45ed911e2fc1557.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"🧠 Key takeaways","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Yo7dawNYHc"}],"key":"qKtz808a6z"},{"type":"card","url":"#spatial-introduction-key-takeaway-1","children":[{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Spatially resolved genomics technologies enable the measurement of genome-scale omics data while preserving spatial context, offering multi-cell, single-cell, and sub-cellular resolution to address diverse biological questions.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"pXp6ZwDQLB"}],"key":"Cg7OrZEUCy"}],"urlSource":"#spatial-introduction-key-takeaway-1","key":"lOW409Y7hV"}],"key":"Cohmz5XSMz"},{"type":"comment","value":" END DROPDOWNS ","key":"vjGlpRbMLn"},{"type":"heading","depth":2,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Motivation","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"rsdPD3Cd3E"}],"label":"spatial-introduction-key-takeaway-1","identifier":"spatial-introduction-key-takeaway-1","html_id":"spatial-introduction-key-takeaway-1","key":"kjKJD4zgig"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Bulk and single-cell genomic technologies enabled us to characterize and understand cellular identities and their dependencies on genome scale. Up to this point, all single-cell technologies described in this work characterized dissociated cells that were removed from the sample of interest. However, by removing the spatial context of the cells and their molecules, one also loses the spatial context which is an essential component for many biological questions. Spatially resolved genomics resolve this issue by measuring both genome-scale omics and preserving the spatial information.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"vHfzjuzbI6"}],"key":"njF27c4JsK"}],"key":"SumLBEUnBT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Overview of spatial profiling measurements","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vNZjqTZz5G"}],"identifier":"overview-of-spatial-profiling-measurements","label":"Overview of spatial profiling measurements","html_id":"overview-of-spatial-profiling-measurements","implicit":true,"key":"nHEodrqsTZ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Spatially resolved genomics can be measured with various technologies that quantify the transcriptome, proteome or chromatin accessibility. However, these technologies vary in terms of scale, resolution, sensitivity, multiplexing and applicability. As the landscape of spatially resolved genomics is developing fast and is expected to change massively in the next few years, we are introducing only three overall groups of spatial omics technologies based on their capturing resolution. Additional information can be obtained through the linked reviews and papers following this introduction. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VJEEaHokoZ"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"spat:moffitt_emerging_2022","identifier":"spat:moffitt_emerging_2022","children":[{"type":"text","value":"Moffitt ","key":"kK4cQTzVHc"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"nqGc9P3bEo"}],"key":"imL9eto20H"},{"type":"text","value":", 2022","key":"gnJ5bAfvsE"}],"enumerator":"1","key":"b7NLxyaVhd"}],"key":"FjBxu3YYnn"},{"type":"text","value":" ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ti1GgUNlVQ"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"spat:walker_deciphering_2022","identifier":"spat:walker_deciphering_2022","children":[{"type":"text","value":"Walker ","key":"q8KNWRESgU"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"opy3oKrWqn"}],"key":"OA4gHinh8q"},{"type":"text","value":", 2022","key":"dOMGRWJghW"}],"enumerator":"2","key":"OlMNslAd9O"}],"key":"cIfbHOtm9O"},{"type":"text","value":" ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iqI8EkqPiq"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"spat:yue_guidebook_2023","identifier":"spat:yue_guidebook_2023","children":[{"type":"text","value":"Yue ","key":"WKEvfPFvZp"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"kvgNwzlOqF"}],"key":"Kqtk03adTX"},{"type":"text","value":", 2023","key":"XSk5M4Xerz"}],"enumerator":"3","key":"Hughso6ysF"}],"key":"b7lEjtihnr"}],"key":"yszqO4QIwZ"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/introduction_1-9323e157da1e3ccd01cd8c12be2b23a8.jpeg","alt":"Spatial Omics Resolutions Overview","width":"800px","key":"cM0XJDhuEl","urlSource":"../_static/images/spatial/introduction_1.jpeg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"resolutions","identifier":"resolutions","html_id":"resolutions","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"VDdHZJm7ZS"},{"type":"text","value":"1","key":"c51dMsKCdt"},{"type":"text","value":":","key":"KPFO7fRfiB"}],"template":"Figure %s:","key":"z1f6ix5utG"},{"type":"text","value":"Spatially resolved genomics data varies in resolution from multi-cell, single-cell to sub-cellular resolution.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"RZdbo1y8my"}],"key":"YOyY8DCxAe"}],"key":"t3yg7TLS1l"}],"class":"bg-primary mb-1","label":"resolutions","identifier":"resolutions","enumerator":"1","html_id":"resolutions","key":"aKIqraE3bc"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Broadly spoken, one can differentiate spatially resolved genomics into technologies that measure at multi-cell, single-cell and sub-cellular resolution. We will shortly motivate each of those scales and highlight their advantages and challenges and introduce the reader to a few technologies that fall into the respective category.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"op51GhGtsr"}],"key":"FVZp9HXoLp"}],"key":"ps8vOxeyyH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Multi-cell resolution","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i2kmYjfphu"}],"identifier":"multi-cell-resolution","label":"Multi-cell resolution","html_id":"multi-cell-resolution","implicit":true,"key":"J5m1bOTgeE"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Spatial omics data obtained at multi-cell resolution typically captures omics measurements among several cells. So, each datapoint contains information from a varying number of cells and also potentially different cell types. Multi-cell resolution data can be decomposed with deconvolution methods to obtain proportions of different cells or cell types per spot.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ddMAnxMvuL"}],"key":"lhpLcy85M5"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Multi-cell resolution data typically capture transcriptome-wide gene expression profiles at varying resolution. The obtained resolution for spot-based technologies varies between 55um (Visium) to 10 um (slide-seq). A widely known, commercially available and successful technology is Visium provided by 10x Genomics. We will showcase how to analyze and deconvolve Visium data in the tutorials.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"MXVksZDj5o"}],"key":"UcomkimS3b"}],"key":"QeXsOe0jOW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Single-cell resolution","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DO78kaI9u0"}],"identifier":"single-cell-resolution","label":"Single-cell resolution","html_id":"single-cell-resolution","implicit":true,"key":"ZvI7cs9RpT"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Spatial omics data obtained at single-cell resolution either directly capture single cells at their exact position or capture spots on the scale of single-cell. Examples for spot-based methods are HDST, slide-seqV2 or stereo-seq. These methods capture the whole transcriptome but still have a low capture efficiency.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Ijay9UuAwr"}],"key":"OOgDumFJgy"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Targeted methods provide an alternative for measuring cells at their exact position. Common examples are MERFISH, seqFISH+, IMC or multiplexed IHC (e.g. cyCIF and CODEX). These technologies are usually expensive and only measure a limited features space. These methods do not capture spots at a predefined location or grid, but measure individual transcript or cellular locations.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"UFb7m97S2W"}],"key":"geBMlUSGtH"}],"key":"TfdUtyfzWQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Sub-cellular resolution","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DjWzrHuIng"}],"identifier":"sub-cellular-resolution","label":"Sub-cellular resolution","html_id":"sub-cellular-resolution","implicit":true,"key":"nW9anjqR3i"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Spatial omics data at sub-cellular resolution captures the position of individual RNA molecules. Those positions can either be captured through single-molecule imaging or via spatial barcoding with spot-sizes smaller than single-cells. By performing cell segmentation on sub-cellular data one can obtain single-cell resolution data where expression is aggregated to cell-wise measurements which than can be processed in spatially-aware analysis pipelines. We will show how to perform this analysis for a MERFISH dataset.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xxLGxwRryL"}],"key":"LcEk7wtiT6"}],"key":"zq8Rlin5fA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Recommended reading","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jxZRkTPoKj"}],"identifier":"recommended-reading","label":"Recommended reading","html_id":"recommended-reading","implicit":true,"key":"yB3gBUHqea"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"To get a more elaborate understanding of the differences between the spatial experimental assays we recommend the following papers:","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"SuG2EYUfzr"}],"key":"d5J3dboWW5"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"The emerging landscape of spatial profiling technologies ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"cZ74KdYOwu"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"spat:moffitt_emerging_2022","identifier":"spat:moffitt_emerging_2022","children":[{"type":"text","value":"Moffitt ","key":"qg4RZ8pkqV"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"YlLvyrlFuf"}],"key":"FjbahSz3YV"},{"type":"text","value":", 2022","key":"X04q2AptwG"}],"enumerator":"1","key":"BQooKPNUYf"}],"key":"IGcHmLddW7"}],"key":"xaKHtIx3dW"}],"key":"n0XaMkYWX4"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Deciphering tissue structure and function using spatial transcriptomics ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"McvHlR29GC"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"spat:walker_deciphering_2022","identifier":"spat:walker_deciphering_2022","children":[{"type":"text","value":"Walker ","key":"DHPGs0knvL"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"mLppm7LP2T"}],"key":"YXn8hMd4V1"},{"type":"text","value":", 2022","key":"lGeS80fLjb"}],"enumerator":"2","key":"oWYOE03uuy"}],"key":"yRAgMrkCwj"}],"key":"EwLIdgBjki"}],"key":"KKDZTjOrKj"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"A guidebook of spatial transcriptomic technologies, data resources and analysis approaches ","position":{"start":{"line":10,"column":1},"end":{"line":