{"version":3,"kind":"Article","sha256":"2609ba8a3d254006c7de4c80ed4aa5a7339dbc6ca33a10d968f71159b4eaec13","slug":"outlook","location":"/outlook.md","dependencies":[],"frontmatter":{"title":"Outlook","numbering":{"all":{"enabled":false}},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Lukas Heumos","given":"Lukas","family":"Heumos"},"name":"Lukas Heumos","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Anna Schaar","given":"Anna","family":"Schaar"},"name":"Anna Schaar","id":"contributors-myst-generated-uid-1"},{"nameParsed":{"literal":"single-cell best practices consortium","given":"single-cell","non_dropping_particle":"best practices","family":"consortium"},"name":"single-cell best practices consortium","id":"contributors-myst-generated-uid-2"}],"github":"https://github.com/theislab/single-cell-best-practices","settings":{"output_matplotlib_strings":"remove"},"source_url":"https://github.com/theislab/single-cell-best-practices/blob/main/jupyter-book/outlook.md","edit_url":"https://github.com/theislab/single-cell-best-practices/edit/main/jupyter-book/outlook.md","exports":[{"format":"md","filename":"outlook.md","url":"/build/outlook-b973b5658b3be421293f9b4f8b165bef.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Single-cell analysis has moved from a niche technology to a routine part of biology and medicine.\nDatasets now span hundreds of millions of cells, models are pretrained on all of them, and software agents are starting to run analyses on their own.\nNone of this makes careful analysis less important; it raises the cost of getting it wrong.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"vfAN6QLJnU"}],"key":"ykxblvgmRc"},{"type":"heading","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Benchmarking","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"biJAmZ0Nxc"}],"identifier":"benchmarking","label":"Benchmarking","html_id":"benchmarking","implicit":true,"key":"ssBiUtgk6u"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"New tools appear faster than anyone can evaluate them by hand.\nLiving benchmarks such as ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ykyzmZvdO8"},{"type":"link","url":"https://openproblems.bio/","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Open Problems in Single-Cell Analysis","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"TywyJEJI5n"}],"urlSource":"https://openproblems.bio/","key":"tqpn3JXBXE"},{"type":"text","value":" ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"xTBE1HU3JF"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"ol:Luecken2025","identifier":"ol:luecken2025","children":[{"type":"text","value":"Luecken ","key":"xNhNgfqnQV"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"lEYExMiXRn"}],"key":"H3atjGvQMQ"},{"type":"text","value":", 2025","key":"VCX1m5ve3b"}],"enumerator":"1","key":"clvrkjxAUJ"}],"key":"hgcLtGn9Ui"},{"type":"text","value":" compare methods on shared datasets and metrics, and we will keep updating our recommendations as their results change.\nBenchmarks are only as good as their metrics, so agreeing on what defines a good result for each task remains an open problem.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"aIj3Gt49hB"}],"key":"oSvTWzOjVN"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Foundation models and virtual cells","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"N9IMJ4ACNG"}],"identifier":"foundation-models-and-virtual-cells","label":"Foundation models and virtual cells","html_id":"foundation-models-and-virtual-cells","implicit":true,"key":"Lo61GbjUAd"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Models pretrained on tens of millions of cells promise general cell representations that transfer to annotation, integration, and perturbation prediction.\nThe long-term goal is a virtual cell that predicts how any cell responds to any perturbation ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"QlKqL0lKKe"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"ol:Bunne2024","identifier":"ol:bunne2024","children":[{"type":"text","value":"Bunne ","key":"wXxpmCv1LT"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"cFoypZHX6M"}],"key":"Rg3HMNaT8B"},{"type":"text","value":", 2024","key":"swPthOOIqQ"}],"enumerator":"2","key":"tXtb2s30B6"}],"key":"AGto40rzEL"},{"type":"text","value":".\nSo far, careful evaluations show that these models often do not beat simple baselines, both for zero-shot embeddings ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"xvJcGoFLsp"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"ol:Kedzierska2025","identifier":"ol:kedzierska2025","children":[{"type":"text","value":"Kedzierska ","key":"K42kFRsKLK"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"QDy1moast7"}],"key":"SYwTVwKKAc"},{"type":"text","value":", 2025","key":"yHwgRsmLkv"}],"enumerator":"3","key":"i0MNnkhplm"}],"key":"q9UXGbykob"},{"type":"text","value":" and for perturbation effect prediction ","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"jnzKb2W1LB"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"ol:AhlmannEltze2025","identifier":"ol:ahlmanneltze2025","children":[{"type":"text","value":"Ahlmann-Eltze ","key":"JZ0WQSCsZJ"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"Q8ubAWKlJz"}],"key":"WYbFiMNlh3"},{"type":"text","value":", 2025","key":"kM6aPgEVy2"}],"enumerator":"4","key":"GUfwSjEBNV"}],"key":"OI2W2a3Aar"},{"type":"text","value":".\nUntil that changes, any foundation model should be compared against a simple baseline on the data at hand.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"rIhy7MdEon"}],"key":"yyC7NonFUq"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Agentic analysis","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"wwKBxkIYqH"}],"identifier":"agentic-analysis","label":"Agentic analysis","html_id":"agentic-analysis","implicit":true,"key":"v8307eBDLS"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Large language model agents can now plan an analysis, write the code, and run it ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"MDCRjHtjwn"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"ol:Huang2025","identifier":"ol:huang2025","children":[{"type":"text","value":"Huang ","key":"Iptjc7MehX"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"VnCX6IlZjp"}],"key":"UYqbnN2BbS"},{"type":"text","value":", 2025","key":"W5pP6sm6mZ"}],"enumerator":"5","key":"qaEaQM9tyI"}],"key":"ig3sPGEzMl"},{"type":"text","value":".\nThis lowers the barrier to single-cell analysis, but it does not remove the need to know what a good analysis looks like.\nAn agent can pick an unsuitable normalization, leak information between training and test data, or over-interpret clusters just as confidently as a person can, only faster.\nWe expect best practices like the ones in this book to become the reference that agents follow and that people use to check their output.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"nvQb9czBR5"}],"key":"zpe20BSV4e"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Scale","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"YKd2WOzBnn"}],"identifier":"scale","label":"Scale","html_id":"scale","implicit":true,"key":"OBNz16A3eY"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Perturbation atlases such as Tahoe-100M ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"WuYEDuuFAe"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"ol:Zhang2025","identifier":"ol:zhang2025","children":[{"type":"text","value":"Zhang ","key":"ptZquOT5l3"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"ZBTgSx4c5Z"}],"key":"WPy4hJtA0V"},{"type":"text","value":", 2025","key":"jLzTN9XVbT"}],"enumerator":"6","key":"rFOZG2hWkB"}],"key":"TzsInmqFDM"},{"type":"text","value":" profile more than 100 million cells in a single study.\nAt this scale, CPU-based analysis becomes the bottleneck, and GPU-accelerated tools such as ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ffWZmW0Mbp"},{"type":"link","url":"/introduction/rapids-singlecell","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"rapids-singlecell","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"cXN7SrgXQH"}],"urlSource":"introduction/rapids_singlecell.ipynb","dataUrl":"/introduction.rapids-singlecell.json","internal":true,"protocol":"file","key":"YKyUyfE0xN"},{"type":"text","value":" ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"VLjDWz6dHy"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"ol:Dicks2026","identifier":"ol:dicks2026","children":[{"type":"text","value":"Dicks ","key":"pVb9wJTc47"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"HUDYzBrsEy"}],"key":"HxkEElsR4Y"},{"type":"text","value":", 2026","key":"WP4u5rDct9"}],"enumerator":"7","key":"ItfI6KKLXr"}],"key":"DgtrSYFPJb"},{"type":"text","value":" are becoming the default.\nJointly reanalyzing existing datasets at this scale could also uncover biology that individual studies missed.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"lBX6PDZVAV"}],"key":"q2KqxyB1yu"},{"type":"heading","depth":2,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Spatial and multimodal data","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"KsEFbVrkpT"}],"identifier":"spatial-and-multimodal-data","label":"Spatial and multimodal data","html_id":"spatial-and-multimodal-data","implicit":true,"key":"TPC35jDEen"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Spatial transcriptomics now measures thousands of genes at subcellular resolution, placing cell states back into their tissue context.\nMeasuring every modality in every cell remains infeasible, so methods that predict missing modalities and integrate unpaired data will stay important.\nSingle-cell proteomics ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"yOVOtmqFKk"},{"type":"citeGroup","kind":"parenthetical","children":[{"type":"cite","kind":"parenthetical","label":"ol:Brunner2022","identifi